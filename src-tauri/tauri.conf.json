{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal Canvas",
  "identifier": "local.terminalcanvas.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: tc-asset: http://tc-asset.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "capabilities": ["main"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNTI2NUVFNUNFRDYzN0YKUldSL1krMWM3bVZTb3BJcGdQSFlBTzBoMGVBUVlqWEdRQmVuUGNrTFRIclZRZldtczlCYytKVEoK",
      "endpoints": ["https://github.com/yutigi/TerminalCanvas/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../src/assets/icon.png", "../src/assets/icon.ico"]
  }
}
