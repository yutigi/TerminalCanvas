{
    "name": "terminal-canvas",
    "version": "0.1.0",
    "private": true,
    "description": "A spatial desktop workspace for AI terminals.",
    "scripts": {
        "start": "cargo run -p terminal-canvas",
        "check": "cargo xtask syntax",
        "test": "node --test tests/*.test.cjs",
        "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.cjs",
        "test:smoke": "npm run test:e2e",
        "test:restoration": "node --test tests/e2e/restoration.test.cjs",
        "icons": "cargo xtask icons",
        "build": "cargo xtask package-windows",
        "test:layout": "node scripts/check-layout.cjs"
    },
    "devDependencies": {
        "@xterm/addon-fit": "0.11.0",
        "@xterm/xterm": "6.0.0",
        "playwright-core": "1.65.0"
    },
    "engines": {
        "node": ">=22.12"
    }
}
